# Django Core Configuration
SECRET_KEY=your-django-secret-key-placeholder
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Connection
# Local Development defaults to SQLite (db.sqlite3) if unset.
# Production on Render uses Neon Serverless PostgreSQL via DATABASE_URL environment variable.
DATABASE_URL=sqlite:///db.sqlite3

# External AI & Email Services
GOOGLE_API_KEY=your-google-gemini-api-key-placeholder
RESEND_API_KEY=your-resend-api-key-placeholder

# Optional SMTP Fallback Configuration
EMAIL_HOST_USER=your-email-placeholder@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-placeholder
